rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Social mode — unchanged behaviour (fully open), now scoped explicitly
    // so the financial-mode rules below can actually restrict access.
    // (Rules are OR'd: a catch-all `allow if true` would override them.)
    // ---------------------------------------------------------------------
    match /log_groups/{path=**} {
      allow read, write: if true;
    }
    match /log_posts/{path=**} {
      allow read, write: if true;
    }
    // The signed-in person owns this user doc (doc ids aren't auth uids).
    function ownsUserDoc(userDocId) {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(userDocId)).data.userId == request.auth.uid;
    }

    // User docs are private to their owner (email, view tracking, prefs). Everyone else
    // reads the public profiles/ mirror. The auth uid in `userId` is fixed at creation,
    // which is what makes ownsUserDoc() trustworthy. Deleting is server-only
    // (deleteAccount). Subcollections each have their own rules (rules are OR'd, so
    // this can't be a users/{path=**} wildcard).
    match /users/{userDocId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if false;
    }
    match /users/{userDocId}/achievements/{path=**} {
      // Milestone achievements come with a knick-knack and only the server writes them
      // (functions/src/awardMilestone.ts); the group ones are still awarded client-side.
      // Their types are the knick-knacks' ids (MILESTONE_ACHIEVEMENTS).
      allow read, delete: if ownsUserDoc(userDocId);
      allow create, update: if ownsUserDoc(userDocId)
        && !(request.resource.data.type in [
          "copper_coin", "silver_coin", "gold_coin", "extra_shiny_gold_coin",
          "heart_leaf", "paper_crane", "friendship_bracelet", "little_envelope"
        ]);
    }

    // Public profiles: the mirrorProfile function projects name, location, timezone,
    // avatar, pinned posts and last-posted times out of users/{id} (same doc id).
    // Readable by anyone, including spectators on a public log; only the server writes
    // them.
    match /profiles/{userDocId} {
      allow read: if true;
      allow write: if false;
    }

    // Public knick-knack shelves: each kept item once, with how the first copy came to
    // its owner (mirrorShelf). Signed-in people may read them; only the server writes.
    match /shelves/{userDocId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // One doc per pair of users, written only by the friend callables. Each side may
    // read it (list queries filter on uids array-contains their uid).
    match /friendships/{pairId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.uids;
      allow write: if false;
    }

    // Personal invite links: code → inviter. Only the invite callables touch these.
    match /invites/{code} {
      allow read, write: if false;
    }

    // Cloud Functions write notifications (the Admin SDK bypasses rules). The owner may
    // read them and stamp readAt, and may create only the ones whose actor is
    // themselves: starting or joining a log.
    match /users/{userDocId}/notifications/{notificationId} {
      allow read, delete: if ownsUserDoc(userDocId);
      allow update: if ownsUserDoc(userDocId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"]);
      allow create: if ownsUserDoc(userDocId)
        && request.resource.data.type in ["log_created", "log_joined"]
        && request.resource.data.readAt == null;
    }
    // Push tokens, one per app install (features/push/devicePush.ts). The owner registers
    // and removes their own; sendPushOnNotification reads them with the Admin SDK.
    match /users/{userDocId}/devices/{installId} {
      allow read, delete: if ownsUserDoc(userDocId);
      allow create, update: if ownsUserDoc(userDocId)
        && request.resource.data.keys().hasOnly(["token", "platform", "updatedAt"])
        && request.resource.data.token is string
        && request.resource.data.platform in ["ios", "android"];
    }
    // Knick-knacks the budget buddy found (rolled on visits and logged entries). The owner
    // may read them and mark each one seen, once; only the server creates or deletes them.
    // users/{id}/buddy (roll marker, streak, luck numbers) has no rule: server only.
    // Luck as the owner sees it: just its tier, in words. Only the server writes it.
    match /users/{userDocId}/luck/{doc} {
      allow read: if ownsUserDoc(userDocId);
    }
    match /users/{userDocId}/knickknacks/{findId} {
      // Owner only: how many of anything someone has is private. Other people see the
      // shelves/ mirror instead, which lists each kept item once. The one exception: a
      // giver may read their own gift while it's still wrapped (unseen), to show it in
      // transit on the friend's profile. Queries must filter giftedBy == their own user
      // doc id and seenAt == null, so nobody sees gifts from anyone else.
      allow read: if ownsUserDoc(userDocId)
        || (resource.data.seenAt == null && ownsUserDoc(resource.data.giftedBy));
      allow update: if ownsUserDoc(userDocId)
        && resource.data.seenAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["seenAt"])
        && request.resource.data.seenAt is timestamp;
    }
    match /processing/{path=**} {
      allow read, write: if true;
    }
    // App-wide settings: config/app holds the minimum supported native version and the
    // store links. Anyone may read (the check runs before sign-in); only the console writes.
    match /config/{docId} {
      allow read: if true;
    }

    // ---------------------------------------------------------------------
    // Financial mode — members only.
    // ---------------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    function ledgerData(ledgerId) {
      return get(/databases/$(database)/documents/ledgers/$(ledgerId)).data;
    }

    function isLedgerMember(ledgerId) {
      return signedIn() && request.auth.uid in ledgerData(ledgerId).memberUids;
    }

    function validLedgerFields(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 20
        && d.max_participants is int && d.max_participants >= 1 && d.max_participants <= 30
        && d.categories is list && d.categories.size() <= 50
        && d.defaultCurrency is string
        && d.memberUids is list && d.members is list
        && d.memberUids.size() == d.members.size()
        && d.memberUids.size() <= d.max_participants;
    }

    match /ledgers/{ledgerId} {
      // `get` and `list` both reference resource.data, so the
      // `memberUids array-contains uid` list query is provable.
      // Reading a ledger that doesn't exist (e.g. just deleted) is allowed so the app can
      // show "not found" rather than "private"; there's no data to leak.
      allow read: if signedIn()
        && (resource == null || request.auth.uid in resource.data.memberUids);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['title', 'max_participants', 'members', 'memberUids', 'categories',
              'defaultCurrency', 'createdAt', 'createdBy'])
        // Optional so tabs still running the previous app build can create ledgers.
        && (!('createdBy' in request.resource.data)
            || request.resource.data.createdBy == request.auth.uid)
        && validLedgerFields(request.resource.data)
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.createdAt == request.time;

      // Members edit settings (title, categories, default currency, cap).
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberUids
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'categories', 'defaultCurrency', 'max_participants'])
        && validLedgerFields(request.resource.data);

      // A signed-in non-member joins via the invite link: they may only add
      // themselves (via arrayUnion), and only while there's room.
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.memberUids)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['members', 'memberUids'])
        && request.resource.data.memberUids.toSet()
             == resource.data.memberUids.toSet().union([request.auth.uid].toSet())
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.memberUids.size() <= resource.data.max_participants;

      allow delete: if false;

      function validEntry(d) {
        // importSource / importBatchId are set only by the importLedgerEntries function.
        return d.keys().hasOnly(
               ['amount', 'currency', 'categoryId', 'date', 'month', 'note',
                'author', 'authorUid', 'authorName', 'createdAt', 'updatedAt',
                'importSource', 'importBatchId'])
          && d.keys().hasAll(
               ['amount', 'currency', 'categoryId', 'date', 'month',
                'author', 'authorUid', 'authorName', 'createdAt', 'updatedAt'])
          && (d.amount is int || d.amount is float) && d.amount > 0
          && d.currency is string && d.currency.size() == 3
          && d.categoryId is string && d.categoryId.size() > 0
          && d.month is string && d.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && d.date is string && d.date.matches('^' + d.month + '-(0[1-9]|[12][0-9]|3[01])$')
          && (!('note' in d) || (d.note is string && d.note.size() <= 140))
          && d.authorName is string
          && d.authorUid == request.auth.uid
          && d.updatedAt == request.time;
      }

      match /entries/{entryId} {
        allow read: if isLedgerMember(ledgerId);

        // No new entries while the deleteLog function is removing the ledger.
        allow create: if isLedgerMember(ledgerId)
          && ledgerData(ledgerId).get('deleting', false) == false
          && validEntry(request.resource.data)
          && !('importSource' in request.resource.data)
          && !('importBatchId' in request.resource.data)
          && request.resource.data.createdAt == request.time;

        // Only the author may edit or delete; authorship and createdAt are immutable.
        allow update: if isLedgerMember(ledgerId)
          && resource.data.authorUid == request.auth.uid
          && validEntry(request.resource.data)
          && request.resource.data.author == resource.data.author
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.get('importSource', null) == resource.data.get('importSource', null)
          && request.resource.data.get('importBatchId', null) == resource.data.get('importBatchId', null);

        allow delete: if isLedgerMember(ledgerId)
          && resource.data.authorUid == request.auth.uid;
      }

      // Derived monthly summaries — written only by Cloud Functions (Admin SDK).
      match /months/{month} {
        allow read: if isLedgerMember(ledgerId);
        allow write: if false;
      }
    }
  }
}
