rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Social mode — unchanged behaviour (fully open), now scoped explicitly
    // so the financial-mode rules below can actually restrict access.
    // (Rules are OR'd: a catch-all `allow if true` would override them.)
    // ---------------------------------------------------------------------
    match /log_groups/{path=**} {
      allow read, write: if true;
    }
    match /log_posts/{path=**} {
      allow read, write: if true;
    }
    // User docs and their achievements stay open. Notifications are private to their
    // owner, so this can't be a users/{path=**} wildcard (rules are OR'd).
    match /users/{userDocId} {
      allow read, write: if true;
    }
    match /users/{userDocId}/achievements/{path=**} {
      allow read, write: if true;
    }

    // Cloud Functions write notifications (the Admin SDK bypasses rules). The owner may
    // read them and stamp readAt, and may create only the ones whose actor is
    // themselves: starting or joining a log.
    function ownsUserDoc(userDocId) {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(userDocId)).data.userId == request.auth.uid;
    }
    match /users/{userDocId}/notifications/{notificationId} {
      allow read, delete: if ownsUserDoc(userDocId);
      allow update: if ownsUserDoc(userDocId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"]);
      allow create: if ownsUserDoc(userDocId)
        && request.resource.data.type in ["log_created", "log_joined"]
        && request.resource.data.readAt == null;
    }
    match /processing/{path=**} {
      allow read, write: if true;
    }

    // ---------------------------------------------------------------------
    // Financial mode — members only.
    // ---------------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    function ledgerData(ledgerId) {
      return get(/databases/$(database)/documents/ledgers/$(ledgerId)).data;
    }

    function isLedgerMember(ledgerId) {
      return signedIn() && request.auth.uid in ledgerData(ledgerId).memberUids;
    }

    function validLedgerFields(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 20
        && d.max_participants is int && d.max_participants >= 1 && d.max_participants <= 30
        && d.categories is list && d.categories.size() <= 50
        && d.defaultCurrency is string
        && d.memberUids is list && d.members is list
        && d.memberUids.size() == d.members.size()
        && d.memberUids.size() <= d.max_participants;
    }

    match /ledgers/{ledgerId} {
      // `get` and `list` both reference resource.data, so the
      // `memberUids array-contains uid` list query is provable.
      // Reading a ledger that doesn't exist (e.g. just deleted) is allowed so the app can
      // show "not found" rather than "private"; there's no data to leak.
      allow read: if signedIn()
        && (resource == null || request.auth.uid in resource.data.memberUids);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['title', 'max_participants', 'members', 'memberUids', 'categories',
              'defaultCurrency', 'createdAt', 'createdBy'])
        // Optional so tabs still running the previous app build can create ledgers.
        && (!('createdBy' in request.resource.data)
            || request.resource.data.createdBy == request.auth.uid)
        && validLedgerFields(request.resource.data)
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.createdAt == request.time;

      // Members edit settings (title, categories, default currency, cap).
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberUids
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'categories', 'defaultCurrency', 'max_participants'])
        && validLedgerFields(request.resource.data);

      // A signed-in non-member joins via the invite link: they may only add
      // themselves (via arrayUnion), and only while there's room.
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.memberUids)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['members', 'memberUids'])
        && request.resource.data.memberUids.toSet()
             == resource.data.memberUids.toSet().union([request.auth.uid].toSet())
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.memberUids.size() <= resource.data.max_participants;

      allow delete: if false;

      function validEntry(d) {
        return d.keys().hasOnly(
               ['amount', 'currency', 'categoryId', 'date', 'month', 'note',
                'author', 'authorUid', 'authorName', 'createdAt', 'updatedAt'])
          && d.keys().hasAll(
               ['amount', 'currency', 'categoryId', 'date', 'month',
                'author', 'authorUid', 'authorName', 'createdAt', 'updatedAt'])
          && (d.amount is int || d.amount is float) && d.amount > 0
          && d.currency is string && d.currency.size() == 3
          && d.categoryId is string && d.categoryId.size() > 0
          && d.month is string && d.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && d.date is string && d.date.matches('^' + d.month + '-(0[1-9]|[12][0-9]|3[01])$')
          && (!('note' in d) || (d.note is string && d.note.size() <= 140))
          && d.authorName is string
          && d.authorUid == request.auth.uid
          && d.updatedAt == request.time;
      }

      match /entries/{entryId} {
        allow read: if isLedgerMember(ledgerId);

        // No new entries while the deleteLog function is removing the ledger.
        allow create: if isLedgerMember(ledgerId)
          && ledgerData(ledgerId).get('deleting', false) == false
          && validEntry(request.resource.data)
          && request.resource.data.createdAt == request.time;

        // Only the author may edit or delete; authorship and createdAt are immutable.
        allow update: if isLedgerMember(ledgerId)
          && resource.data.authorUid == request.auth.uid
          && validEntry(request.resource.data)
          && request.resource.data.author == resource.data.author
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if isLedgerMember(ledgerId)
          && resource.data.authorUid == request.auth.uid;
      }

      // Derived monthly summaries — written only by Cloud Functions (Admin SDK).
      match /months/{month} {
        allow read: if isLedgerMember(ledgerId);
        allow write: if false;
      }
    }
  }
}
