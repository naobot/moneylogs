rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A guest tries the app with an anonymous sign-in (src/features/auth/guest.ts): one
    // click, no email, so "signed in" alone says nothing about who they are. Guests can't
    // join other people's logs or read what's shared with signed-in people only.
    function isGuest() {
      return request.auth.token.firebase.sign_in_provider == "anonymous";
    }
    // Signed in with a real account (not a guest).
    function hasAccount() {
      return request.auth != null && !isGuest();
    }

    // The signed-in person owns this user doc (doc ids aren't auth uids).
    function ownsUserDoc(userDocId) {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(userDocId)).data.userId == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // Social mode (log_groups, log_posts). Everything is publicly readable, since
    // spectators view /g/:groupId signed out. Writes follow src/hooks/useLogGroupQuery.ts
    // and useLogPostQuery.ts. Members and authors are users/ doc *references*, so each
    // check proves the caller owns the reference they act through. Server fields
    // (analytics, images, createdAt on posts, latestCommentAt) are Admin SDK only.
    // ---------------------------------------------------------------------
    function userPath(userDocId) {
      return /databases/$(database)/documents/users/$(userDocId);
    }
    // `ref` is exactly a users/{id} reference (not something nested under one, whose last
    // id the functions would take as the user) and the caller owns it.
    function ownsUserRef(ref) {
      return ref is path && ref == userPath(ref[4]) && ownsUserDoc(ref[4]);
    }
    // `ref` is exactly a log_groups/{id} reference.
    function isLogRef(ref) {
      return ref is path && ref == /databases/$(database)/documents/log_groups/$(ref[4]);
    }
    function groupMembers(groupRef) {
      return get(groupRef).data.members;
    }
    // Entries can be added, or their amounts and dates changed, until the log has closed
    // in every timezone and its summary is saved (processGroupAnalytics). A wall-clock
    // log closes at its wall-clock end in UTC-12, at most 26h after the stored `end` (the
    // creator's instant, UTC+14 at the latest); older logs close at `end`.
    function logTakesEntries(groupRef) {
      let g = get(groupRef).data;
      return !g.get(['analytics', 'isCalculated'], false)
        && request.time <= g.end + duration.value(('endWallClock' in g) ? 93600 : 0, 's');
    }
    // purgeLog flags a log `deleting` before it removes the posts: nothing new may land
    // in it, or it would outlive the log.
    function logNotDeleting(groupRef) {
      return get(groupRef).data.get('deleting', false) == false;
    }

    match /log_groups/{groupId} {
      allow read: if true;

      // A new log has its creator as the only member (addNewLogGroupFn).
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['title', 'max_participants', 'startWallClock', 'endWallClock', 'start', 'end',
              'createdAt', 'createdBy', 'members'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
        && request.resource.data.max_participants is int
        // MAX_PARTICIPANTS (src/features/createLog/wizardSteps.ts). The join rule keeps
        // members within it, which is what bounds the reaction keys checked below.
        && request.resource.data.max_participants >= 1
        && request.resource.data.max_participants <= 30
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && ownsUserRef(request.resource.data.members[0]);

      // Rename: the creator only (LogTitleSection). Logs from before `createdBy` was
      // stamped can't be renamed until it's backfilled (src/utils/logOwnership.ts).
      allow update: if request.auth != null
        && resource.data.get('createdBy', null) == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100;

      // Join through the invite page (joinGroupFn): prepend yourself, keep everyone
      // else, and only while there's room. Not as a guest: joining someone else's log
      // needs a saved account (guests may still spectate, and post in their own logs).
      allow update: if hasAccount()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.members.size() <= resource.data.get('max_participants', 0)
        && request.resource.data.members.hasAll(resource.data.members)
        && !(request.resource.data.members[0] in resource.data.members)
        && ownsUserRef(request.resource.data.members[0]);

      // Deleting a log is the deleteLog function's job (it cascades).
      allow delete: if false;
    }

    match /log_posts/{postId} {
      allow read: if true;

      // A member posts as themselves into one of their logs (addNewLogPostFn).
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['amount', 'currency', 'amounts', 'amountsPrimary', 'content', 'author',
              'authorName', 'postDate', 'group', 'groupName', 'commentSubscribers',
              'pulledEntryIds', 'timezone', 'timezonePlace'])
        && validPost(request.resource.data)
        && ownsUserRef(request.resource.data.author)
        && isLogRef(request.resource.data.group)
        && request.resource.data.author in groupMembers(request.resource.data.group)
        && request.resource.data.commentSubscribers == [request.resource.data.author]
        && logTakesEntries(request.resource.data.group)
        && logNotDeleting(request.resource.data.group);

      // The author edits their own entry (editLogPostFn). Once the log has closed, only
      // the words can change: amounts and dates are what the saved summary counted.
      allow update: if ownsUserRef(resource.data.author)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['content', 'postDate', 'amount', 'currency', 'amounts', 'amountsPrimary',
              'pulledEntryIds', 'timezone', 'timezonePlace'])
        && validPost(request.resource.data)
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content'])
          || logTakesEntries(resource.data.group));

      // The fields the app and processGroupAnalytics rely on, with their types.
      function validPost(d) {
        return d.postDate is timestamp
          && (d.amount is int || d.amount is float)
          && d.currency is string
          && d.content is string
          && (!('amounts' in d) || d.amounts is map);
      }

      // A member reacts (toggleReactionFn): only their own reactions.{userDocId} changes.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && reactionChangeIsOwn(
             request.resource.data.reactions.diff(resource.data.get('reactions', {}))
               .affectedKeys());

      // Commenting bumps the count and subscribes the commenter (addCommentFn); deleting
      // a comment lowers it (deleteCommentFn). Each is checked against the comment written
      // in the same batch.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['commentCount', 'commentSubscribers'])
        && commentCountStep(request.resource.data.get('commentCount', 0)
             - resource.data.get('commentCount', 0))
        && subscribesOnlySelf(request.resource.data.get('commentSubscribers', []),
             resource.data.get('commentSubscribers', []));

      allow delete: if ownsUserRef(resource.data.author);

      // Rules can't take an element out of a Set, so the one changed key is found by
      // position in the reactions map's key list (a List, which can be indexed). Only
      // members react, the create and join rules hold members to 30 (MAX_PARTICIPANTS),
      // and account deletion removes a person's keys, so 40 positions cover every reactor.
      // The position checks short-circuit, so only the match costs a get().
      function reactionChangeIsOwn(changed) {
        let keys = request.resource.data.reactions.keys();
        return changed.size() == 1
          && (ownKeyIn10(keys, changed, 0) || ownKeyIn10(keys, changed, 10)
            || ownKeyIn10(keys, changed, 20) || ownKeyIn10(keys, changed, 30));
      }
      function ownKeyIn10(keys, changed, i) {
        return ownKeyAt(keys, changed, i) || ownKeyAt(keys, changed, i + 1)
          || ownKeyAt(keys, changed, i + 2) || ownKeyAt(keys, changed, i + 3)
          || ownKeyAt(keys, changed, i + 4) || ownKeyAt(keys, changed, i + 5)
          || ownKeyAt(keys, changed, i + 6) || ownKeyAt(keys, changed, i + 7)
          || ownKeyAt(keys, changed, i + 8) || ownKeyAt(keys, changed, i + 9);
      }
      // The caller's own reactions.{userDocId}, a short list, and they're in the log.
      function ownKeyAt(keys, changed, i) {
        return keys.size() > i
          && changed.hasOnly([keys[i]])
          && request.resource.data.reactions[keys[i]] is list
          && request.resource.data.reactions[keys[i]].size() <= 20
          && ownsUserDoc(keys[i])
          && userPath(keys[i]) in groupMembers(resource.data.group);
      }

      // The count moves by one per write. (The post rule can't see which comment went with
      // it; the comment rules check the pairing from their side.)
      function commentCountStep(step) {
        return step == 1 || step == -1;
      }

      // Nobody is dropped, and the only one added (if any) is the caller, as a member.
      function subscribesOnlySelf(after, before) {
        return after.hasAll(before)
          && (after.size() == before.size()
            || (after.size() == before.size() + 1
              && ownsUserRef(after.removeAll(before)[0])
              && after.removeAll(before)[0] in groupMembers(resource.data.group)));
      }

      match /comments/{commentId} {
        allow read: if true;

        // A member comments as themselves (addCommentFn), in the same batch as the post's
        // count going up by one.
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'content', 'createdAt'])
          && ownsUserRef(request.resource.data.authorId)
          && request.resource.data.authorId in groupMembers(get(/databases/$(database)/documents/log_posts/$(postId)).data.group)
          && logNotDeleting(get(/databases/$(database)/documents/log_posts/$(postId)).data.group)
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 2000
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/log_posts/$(postId)).data.get('commentCount', 0)
             == get(/databases/$(database)/documents/log_posts/$(postId)).data.get('commentCount', 0) + 1;

        allow update: if false;
        allow delete: if ownsUserRef(resource.data.authorId);
      }
    }

    // User docs are private to their owner (email, view tracking, prefs). Everyone else
    // reads the public profiles/ mirror. The auth uid in `userId` is fixed at creation,
    // which is what makes ownsUserDoc() trustworthy. Deleting is server-only
    // (deleteAccount). Subcollections each have their own rules (rules are OR'd, so
    // this can't be a users/{path=**} wildcard).
    match /users/{userDocId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if false;
    }
    match /users/{userDocId}/achievements/{path=**} {
      // Milestone achievements come with a knick-knack and only the server writes them
      // (functions/src/awardMilestone.ts); their types are the knick-knacks' ids
      // (MILESTONE_ACHIEVEMENTS). Engagement achievements are server-only too
      // (functions/src/awardEngagement.ts, ENGAGEMENT_ACHIEVEMENTS). The group ones are
      // still awarded client-side.
      allow read, delete: if ownsUserDoc(userDocId);
      allow create, update: if ownsUserDoc(userDocId)
        && !(request.resource.data.type in [
          "copper_coin", "silver_coin", "gold_coin", "extra_shiny_gold_coin",
          "heart_leaf", "paper_crane", "friendship_bracelet", "little_envelope", "shiny_gear",
          "first_gift", "first_no_spend_day", "super_lucky", "first_social_log"
        ]);
    }

    // Public profiles: the mirrorProfile function projects name, location, timezone,
    // avatar, pinned posts and last-posted times out of users/{id} (same doc id).
    // Readable by anyone, including spectators on a public log; only the server writes
    // them.
    match /profiles/{userDocId} {
      allow read: if true;
      allow write: if false;
    }

    // Public knick-knack shelves: each kept item once, with how the first copy came to
    // its owner (mirrorShelf). Signed-in people may read them (not guests, except their
    // own); only the server writes.
    match /shelves/{userDocId} {
      allow read: if hasAccount() || ownsUserDoc(userDocId);
      allow write: if false;
    }

    // Public friends lists (mirrorFriendList): only exists while the owner shows it
    // (users.showFriends), and leaves out anyone with users.hideFromFriendLists.
    // Signed-in people may read them, like shelves (not guests, except their own); only
    // the server writes.
    match /friendLists/{userDocId} {
      allow read: if hasAccount() || ownsUserDoc(userDocId);
      allow write: if false;
    }

    // One doc per pair of users, written only by the friend callables. Each side may
    // read it (list queries filter on uids array-contains their uid).
    match /friendships/{pairId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.uids;
      allow write: if false;
    }

    // Pokes and cheers between friends (src/features/nudges): one doc per sender →
    // recipient at {from}__{to}, merge-written by the sender with no read access, read and
    // deleted by the recipient. A TTL policy on expireAt clears unread ones. The one get()
    // of the friendship proves both the friendship and that from/to match their uids.
    function nudgePairId(a, b) {
      return a < b ? a + "__" + b : b + "__" + a;
    }
    function pairs(f, userDocId, uid) {
      return (f.users[0] == userDocId && f.uids[0] == uid)
        || (f.users[1] == userDocId && f.uids[1] == uid);
    }
    function validNudge(nudgeId) {
      let d = request.resource.data;
      let before = resource == null ? 0 : resource.data.pokes;
      let f = get(/databases/$(database)/documents/friendships/$(nudgePairId(d.from, d.to))).data;
      return request.auth != null
        && d.keys().hasOnly(["from", "to", "fromUid", "toUid", "pokes", "cheer", "at", "expireAt"])
        && d.fromUid == request.auth.uid
        && d.from is string && d.to is string && d.from != d.to
        && nudgeId == d.from + "__" + d.to
        && (resource == null
          || (d.from == resource.data.from && d.to == resource.data.to
            && d.fromUid == resource.data.fromUid && d.toUid == resource.data.toUid))
        && d.pokes is int && d.pokes >= before && d.pokes <= before + 50
        && (!("cheer" in d) || d.cheer == null || d.cheer in [
          // src/features/nudges/cheers.ts
          "got_this", "proud", "keep_going", "one_day", "small_wins",
          "treat", "rooting", "high_five", "thinking", "budget_hero"
        ])
        && d.at == request.time
        && d.expireAt is timestamp
        && d.expireAt > request.time
        && d.expireAt <= request.time + duration.value(15, "d")
        && f.status == "accepted"
        && pairs(f, d.from, d.fromUid)
        && pairs(f, d.to, d.toUid);
    }
    match /nudges/{nudgeId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.toUid;
      allow create, update: if validNudge(nudgeId);
    }

    // Personal invite links: code → inviter. Only the invite callables touch these.
    match /invites/{code} {
      allow read, write: if false;
    }

    // Cloud Functions write notifications (the Admin SDK bypasses rules). The owner may
    // read them and stamp readAt, and may create only the ones whose actor is
    // themselves: starting or joining a log.
    match /users/{userDocId}/notifications/{notificationId} {
      allow read, delete: if ownsUserDoc(userDocId);
      allow update: if ownsUserDoc(userDocId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"]);
      allow create: if ownsUserDoc(userDocId)
        && request.resource.data.type in ["log_created", "log_joined"]
        && request.resource.data.readAt == null;
    }
    // Push tokens, one per app install (features/push/devicePush.ts). The owner registers
    // and removes their own; sendPushOnNotification reads them with the Admin SDK.
    match /users/{userDocId}/devices/{installId} {
      allow read, delete: if ownsUserDoc(userDocId);
      allow create, update: if ownsUserDoc(userDocId)
        && request.resource.data.keys().hasOnly(["token", "platform", "updatedAt"])
        && request.resource.data.token is string
        && request.resource.data.platform in ["ios", "android"];
    }
    // Knick-knacks the budget buddy found (rolled on visits and logged entries). The owner
    // may read them and mark each one seen, once; only the server creates or deletes them.
    // users/{id}/buddy (roll marker, streak, luck numbers) has no rule: server only.
    // Luck as the owner sees it: just its tier, in words. Only the server writes it.
    match /users/{userDocId}/luck/{doc} {
      allow read: if ownsUserDoc(userDocId);
    }
    // Confirmed no-spend days (functions/src/noSpend.ts): the owner reads them to show the
    // day as confirmed and for the buddy; only the server writes them.
    match /users/{userDocId}/noSpendDays/{day} {
      allow read: if ownsUserDoc(userDocId);
    }
    // The buddy's month-start review (src/features/ledger/buddy/monthReview.ts): the
    // owner's own answer per log and month. Not a reward input, so the client writes it.
    match /users/{userDocId}/monthReviews/{reviewId} {
      allow read: if ownsUserDoc(userDocId);
      allow create, update: if ownsUserDoc(userDocId)
        && request.resource.data.keys().hasOnly(["status", "snoozedUntil", "updatedAt"])
        && request.resource.data.status in ["snoozed", "dismissed", "reviewing", "done"]
        && (request.resource.data.snoozedUntil == null
          || request.resource.data.snoozedUntil is string)
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{userDocId}/knickknacks/{findId} {
      // Owner only: how many of anything someone has is private. Other people see the
      // shelves/ mirror instead, which lists each kept item once. The one exception: a
      // giver may read their own gift while it's still wrapped (unseen), to show it in
      // transit on the friend's profile. Queries must filter giftedBy == their own user
      // doc id and seenAt == null, so nobody sees gifts from anyone else.
      allow read: if ownsUserDoc(userDocId)
        || (resource.data.seenAt == null && ownsUserDoc(resource.data.giftedBy));
      allow update: if ownsUserDoc(userDocId)
        && resource.data.seenAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["seenAt"])
        && request.resource.data.seenAt is timestamp;
    }
    // Analytics progress for a social log (processGroupAnalytics writes it; LogsSummary
    // listens). Public like the log itself; only the server writes.
    match /processing/{groupId} {
      allow read: if true;
      allow write: if false;
    }
    // App-wide settings: config/app holds the minimum supported native version and the
    // store links. Anyone may read (the check runs before sign-in); only the console writes.
    match /config/{docId} {
      allow read: if true;
    }

    // ---------------------------------------------------------------------
    // Financial mode — members only.
    // ---------------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    function ledgerData(ledgerId) {
      return get(/databases/$(database)/documents/ledgers/$(ledgerId)).data;
    }

    function isLedgerMember(ledgerId) {
      return signedIn() && request.auth.uid in ledgerData(ledgerId).memberUids;
    }

    function validLedgerFields(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 20
        && d.max_participants is int && d.max_participants >= 1 && d.max_participants <= 30
        && d.categories is list && d.categories.size() <= 50
        && d.defaultCurrency is string
        && d.memberUids is list && d.members is list
        && d.memberUids.size() == d.members.size()
        && d.memberUids.size() <= d.max_participants
        // The month's total budget per currency (see Ledger.monthlyBudget).
        && (!('monthlyBudget' in d) || validTotals(d.monthlyBudget));
    }

    // A positive amount up to MAX_BUDGET (src/utils/ledgerCategories.ts), if present.
    function validAmountAt(m, currency) {
      return !(currency in m)
        || ((m[currency] is int || m[currency] is float)
            && m[currency] > 0 && m[currency] <= 1000000000);
    }

    // Monthly totals per currency: only known currencies (CURRENCIES in
    // src/utils/currency.ts), each a real amount.
    function validTotals(m) {
      return m is map
        && m.keys().hasOnly(['JPY', 'USD', 'CAD', 'KRW', 'CNY', 'SGD', 'EUR', 'GBP', 'NTD', 'AUD', 'MYR'])
        && validAmountAt(m, 'JPY') && validAmountAt(m, 'USD') && validAmountAt(m, 'CAD')
        && validAmountAt(m, 'KRW') && validAmountAt(m, 'CNY') && validAmountAt(m, 'SGD')
        && validAmountAt(m, 'EUR') && validAmountAt(m, 'GBP') && validAmountAt(m, 'NTD')
        && validAmountAt(m, 'AUD') && validAmountAt(m, 'MYR');
    }

    // The one record naming both ledgers of a sublog link (functions/src/sublogs.ts).
    // Server-only: a ledger id is enough to join a ledger with room, so a link must
    // never show one side's id to the other side's members.
    match /sublogLinks/{linkId} {
      allow read, write: if false;
    }

    match /ledgers/{ledgerId} {
      // `get` and `list` both reference resource.data, so the
      // `memberUids array-contains uid` list query is provable.
      // Reading a ledger that doesn't exist (e.g. just deleted) is allowed so the app can
      // show "not found" rather than "private"; there's no data to leak.
      allow read: if signedIn()
        && (resource == null || request.auth.uid in resource.data.memberUids);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['title', 'max_participants', 'members', 'memberUids', 'categories',
              'defaultCurrency', 'createdAt', 'createdBy'])
        // Optional so tabs still running the previous app build can create ledgers.
        && (!('createdBy' in request.resource.data)
            || request.resource.data.createdBy == request.auth.uid)
        && validLedgerFields(request.resource.data)
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.createdAt == request.time;

      // Members edit settings (categories, default currency, cap). `parentLink` and
      // `hasRollups` (sublogs) are left out on purpose: only the functions write them.
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberUids
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['categories', 'monthlyBudget', 'defaultCurrency', 'max_participants'])
        && validLedgerFields(request.resource.data);

      // Only the creator renames the log. Mirrors creatorUid() in src/utils/logOwnership.ts:
      // `createdBy`, else the first member (rules make the creator the only member at
      // creation, and joins append).
      allow update: if signedIn()
        && request.auth.uid == resource.data.get('createdBy', resource.data.memberUids[0])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title'])
        && validLedgerFields(request.resource.data);

      // A signed-in non-member joins via the invite link: they may only add
      // themselves (via arrayUnion), and only while there's room. Not as a guest.
      allow update: if signedIn()
        && !isGuest()
        && !(request.auth.uid in resource.data.memberUids)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['members', 'memberUids'])
        && request.resource.data.memberUids.toSet()
             == resource.data.memberUids.toSet().union([request.auth.uid].toSet())
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.memberUids.size() <= resource.data.max_participants;

      allow delete: if false;

      function validEntry(d) {
        // importSource / importBatchId are set only by the importLedgerEntries function,
        // scheduleId only by logScheduledEntries.
        return d.keys().hasOnly(
               ['amount', 'currency', 'categoryId', 'date', 'month', 'note',
                'author', 'authorUid', 'authorName', 'createdAt', 'updatedAt',
                'importSource', 'importBatchId', 'scheduleId'])
          && d.keys().hasAll(
               ['amount', 'currency', 'categoryId', 'date', 'month',
                'author', 'authorUid', 'authorName', 'createdAt', 'updatedAt'])
          && (d.amount is int || d.amount is float) && d.amount > 0
          && d.currency is string && d.currency.size() == 3
          && d.categoryId is string && d.categoryId.size() > 0
          && d.month is string && d.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && d.date is string && d.date.matches('^' + d.month + '-(0[1-9]|[12][0-9]|3[01])$')
          && (!('note' in d) || (d.note is string && d.note.size() <= 140))
          && d.authorName is string
          && d.authorUid == request.auth.uid
          && d.updatedAt == request.time;
      }

      match /entries/{entryId} {
        allow read: if isLedgerMember(ledgerId);

        // No new entries while the deleteLog function is removing the ledger.
        allow create: if isLedgerMember(ledgerId)
          && ledgerData(ledgerId).get('deleting', false) == false
          && validEntry(request.resource.data)
          && !('importSource' in request.resource.data)
          && !('importBatchId' in request.resource.data)
          && !('scheduleId' in request.resource.data)
          && request.resource.data.createdAt == request.time;

        // Only the author may edit or delete; authorship and createdAt are immutable.
        allow update: if isLedgerMember(ledgerId)
          && resource.data.authorUid == request.auth.uid
          && validEntry(request.resource.data)
          && request.resource.data.author == resource.data.author
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.get('importSource', null) == resource.data.get('importSource', null)
          && request.resource.data.get('importBatchId', null) == resource.data.get('importBatchId', null)
          && request.resource.data.get('scheduleId', null) == resource.data.get('scheduleId', null);

        allow delete: if isLedgerMember(ledgerId)
          && resource.data.authorUid == request.auth.uid;
      }

      // Scheduled payments on fixed categories (functions/src/schedulePlan.ts). Members see
      // them all; only the person who set one up changes it, since its entries are logged
      // as theirs. nextDue / nextDueAt / lastLogged are the functions' booking
      // (scheduledEntries.ts) and never written here.
      function validRepeat(r) {
        return r is map && (
          (r.keys().hasOnly(['every', 'day']) && r.keys().hasAll(['every', 'day'])
            && r.every == 'month' && r.day is int && r.day >= 1 && r.day <= 31)
          || (r.keys().hasOnly(['every', 'month', 'day']) && r.keys().hasAll(['every', 'month', 'day'])
            && r.every == 'year' && r.month is int && r.month >= 1 && r.month <= 12
            && r.day is int && r.day >= 1 && r.day <= 31));
      }

      function validSchedule(d) {
        return d.keys().hasOnly(
               ['categoryId', 'label', 'amount', 'currency', 'repeat', 'paused',
                'ownerUid', 'ownerDocId', 'createdAt', 'updatedAt',
                'nextDue', 'nextDueAt', 'lastLogged'])
          && d.keys().hasAll(
               ['categoryId', 'label', 'amount', 'currency', 'repeat',
                'ownerUid', 'ownerDocId', 'createdAt', 'updatedAt'])
          && d.categoryId is string && d.categoryId.size() > 0
          && d.label is string && d.label.size() > 0 && d.label.size() <= 40
          && (d.amount is int || d.amount is float) && d.amount > 0 && d.amount <= 1000000000
          && d.currency in ['JPY', 'USD', 'CAD', 'KRW', 'CNY', 'SGD', 'EUR', 'GBP', 'NTD', 'AUD', 'MYR']
          && validRepeat(d.repeat)
          && (!('paused' in d) || d.paused is bool)
          && d.ownerUid == request.auth.uid
          && d.updatedAt == request.time;
      }

      match /schedules/{scheduleId} {
        allow read: if isLedgerMember(ledgerId);

        allow create: if isLedgerMember(ledgerId)
          && ledgerData(ledgerId).get('deleting', false) == false
          && validSchedule(request.resource.data)
          && !('nextDue' in request.resource.data)
          && !('nextDueAt' in request.resource.data)
          && !('lastLogged' in request.resource.data)
          // The owner's own user doc: its entries are logged with it as author.
          && get(/databases/$(database)/documents/users/$(request.resource.data.ownerDocId)).data.userId
               == request.auth.uid
          && request.resource.data.createdAt == request.time;

        allow update: if isLedgerMember(ledgerId)
          && resource.data.ownerUid == request.auth.uid
          && validSchedule(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['label', 'amount', 'currency', 'repeat', 'paused', 'updatedAt']);

        allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      }

      // Derived monthly summaries — written only by Cloud Functions (Admin SDK).
      match /months/{month} {
        allow read: if isLedgerMember(ledgerId);
        allow write: if false;
      }

      // A sublog's month as it counts in this (parent) ledger: entries by people in both
      // logs, under the linked category. Written only by Cloud Functions (sublogs.ts).
      // Keyed by an opaque link id, never the sublog's ledger id.
      match /rollups/{rollupId} {
        allow read: if isLedgerMember(ledgerId);
        allow write: if false;
      }

      // The budgets a finished month had, kept by the first budget edit after it (see
      // src/utils/budgetHistory.ts). Write-once: a later edit never rewrites history.
      match /budgetSnapshots/{month} {
        allow read: if isLedgerMember(ledgerId);
        allow create: if isLedgerMember(ledgerId)
          && ledgerData(ledgerId).get('deleting', false) == false
          && month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && request.resource.data.keys().hasOnly(['budgets', 'names', 'monthlyBudget', 'snapshotAt'])
          && request.resource.data.budgets is map
          && request.resource.data.names is map
          && (!('monthlyBudget' in request.resource.data)
              || validTotals(request.resource.data.monthlyBudget))
          && request.resource.data.snapshotAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
