{
  "name": "moneylogs",
  "version": "5.16.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && node scripts/write-version.mjs",
    "cap:sync": "CAPACITOR_BUILD=1 vp build && cap sync",
    "cap:sync:dev": "CAPACITOR_BUILD=1 vp build --mode development && cap sync",
    "cap:ios": "npm run cap:sync:dev && cap run ios",
    "cap:android": "node scripts/cap-android.mjs",
    "android:forward": "node scripts/cap-android.mjs --forward-only",
    "android:release": "node scripts/sync-native-version.mjs && npm run cap:sync && cd android && ./gradlew bundleRelease",
    "capacitor:update:after": "node scripts/relative-spm-symlinks.mjs",
    "version": "node scripts/sync-native-version.mjs && git add ios/App/App.xcodeproj/project.pbxproj android/app/build.gradle",
    "lint": "vp lint .",
    "preview": "vp preview",
    "seed-emulator": "npx tsx scripts/seed-emulator.ts",
    "reset-persona": "npx tsx scripts/reset-persona.ts",
    "center-icons": "node scripts/center-icons.mjs",
    "prepare": "vp config",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "vitest run --config e2e/vitest.config.ts"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "8.5.2",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/react": "^10.58.0",
    "@uiw/react-md-editor": "^4.0.7",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.13",
    "firebase": "^11.1.0",
    "frimousse": "0.4.0",
    "react": "^18.3.1",
    "react-date-picker": "^11.0.0",
    "react-dom": "^18.3.1",
    "react-firebase-hooks": "^5.1.1",
    "react-router-dom": "^7.0.2",
    "sentry": "^0.37.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@chromatic-com/vitest": "^1.0.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/firebase": "^2.4.32",
    "@types/lodash": "^4.17.13",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser-playwright": "^5.1.0",
    "chromatic": "^18.14.5",
    "globals": "^15.12.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.65.1",
    "sass": "^1.83.0",
    "sass-embedded": "^1.83.0",
    "sass-loader": "^16.0.4",
    "tsx": "^4.20.2",
    "typescript": "~5.6.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plugin-cdn-import": "^1.0.1",
    "vite-plus": "latest"
  },
  "overrides": {
    "@capacitor-firebase/messaging": {
      "firebase": "$firebase"
    },
    "storybook": {
      ".": "^10.6.7",
      "vite-plus": "$vite-plus"
    },
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.13.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.18.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.27.7": true,
    "@firebase/util": false,
    "@parcel/watcher": false,
    "fsevents": false,
    "protobufjs": false
  }
}
