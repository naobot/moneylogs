# Copy to android/keystore.properties (git-ignored) and fill in. Paths are relative to android/.
# Create the upload key once with:
#   keytool -genkeypair -v -keystore moneylogs-upload.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias upload
# Keep the .jks file and these passwords somewhere safe (a password manager): losing them
# means asking Google to reset the upload key.
storeFile=moneylogs-upload.jks
storePassword=
keyAlias=upload
keyPassword=
